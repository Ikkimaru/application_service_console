<Window x:Class="ApplicationServiceConsole.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application Service Console" Width="1440" Height="900" MinWidth="1080" MinHeight="680"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="350" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock FontSize="21" FontWeight="SemiBold" Text="Service Console" />
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" Text="Project profiles" />
                </StackPanel>
                <TextBlock Grid.Row="1" Margin="0,34,0,10" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" Text="PROFILES" />
                <ListBox Grid.Row="2" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,3" Padding="12" CornerRadius="6" Background="{StaticResource CardBrush}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="3">
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="SCAFFOLD • 0.1.0-alpha.1" />
                    <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}" Text="Process control is planned" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="230" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="27" FontWeight="SemiBold" Text="{Binding SelectedProfile.Name, FallbackValue=Application Service Console}" />
                    <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding StatusMessage}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Margin="0,0,8,0" Command="{Binding ChooseRootCommand}" Content="Choose project folder" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" Content="Refresh discovery" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Margin="0,22,0,14" Padding="14" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter discovered services" />
                    <TextBlock Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="{Binding ServiceSummary}" />
                </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Discovered services" />
                <Button Grid.Column="1" IsEnabled="False" Content="Start All" ToolTip="Process execution is not implemented yet." />
            </Grid>
            <ScrollViewer Grid.Row="3"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Services}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemWidth="260" ItemHeight="172" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="252"
                                    Height="164"
                                    Margin="4"
                                    Padding="13"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="0,0,8,0"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayName}" />
                                        <Border Grid.Column="1" Padding="7,2" Background="#25304A" CornerRadius="8">
                                            <TextBlock FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Status}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               Margin="0,7,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               Text="{Binding Id}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Id}" />
                                    <TextBlock Grid.Row="2"
                                               Margin="0,3,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               Text="{Binding ModulePath}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ModulePath}" />
                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="10" Text="PORT" />
                                            <TextBlock Margin="0,3,0,0" Text="{Binding PortText}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <Button Margin="0,0,6,0"
                                                    Padding="10,7"
                                                    Command="{Binding ToggleEnabledCommand}"
                                                    Content="{Binding EnableActionText}" />
                                            <Button Padding="10,7"
                                                    IsEnabled="False"
                                                    Content="Start"
                                                    ToolTip="Process execution is not implemented yet." />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border Grid.Row="4" Margin="0,18,0,0" Background="#080D19" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="14,11">
                        <TextBlock FontWeight="SemiBold" Text="Log workspace" />
                        <Button HorizontalAlignment="Right" IsEnabled="False" Content="Search history" ToolTip="Available in milestone 3" />
                    </Grid>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontSize="14" Text="No active log session" />
                        <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}" Text="Indexed log capture arrives with the execution engine." />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <Grid Margin="22">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock FontSize="17" FontWeight="SemiBold" Text="Validation diagnostics" />
                <TextBlock Grid.Row="1" Margin="0,6,0,16" Foreground="{StaticResource MutedTextBrush}" Text="{Binding DiagnosticSummary}" />
                <ListBox Grid.Row="2" ItemsSource="{Binding Diagnostics}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="11" Background="{StaticResource CardBrush}" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Heading}" />
                                    <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Text="{Binding Message}" />
                                    <TextBlock Margin="0,5,0,0" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="{Binding ServiceId}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <Border Grid.ColumnSpan="3" Background="#CC0B1020" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="240" Height="4" IsIndeterminate="True" />
                <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" Text="Discovering services…" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
